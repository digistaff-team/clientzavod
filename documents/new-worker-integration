## 🔧 Интеграция с существующей архитектурой

### 1. Подключение в `server.js`

```javascript
// server.js
const { startWorker, stopWorker } = require('./services/content/worker');

// При запуске сервера
async function main() {
    // ... инициализация ...
    
    // Запуск content worker
    const getBots = () => require('./manage/telegram/runner').getBots();
    await startWorker(getBots);
    
    // Graceful shutdown
    process.on('SIGTERM', async () => {
        await stopWorker();
        // ... остальной shutdown ...
    });
}
```

### 2. Настройка `.env`

```bash
# Content Worker Configuration
CONTENT_POLL_INTERVAL_MS=5000
VIDEO_POLL_INTERVAL_MS=10000
MAX_CONCURRENT_JOBS=1
CONTENT_DAILY_TIME=0 9 * * *

# PostgreSQL
PG_HOST=172.17.0.1
PG_PORT=5432
PG_DATABASE=clientzavod
PG_USER=postgres
POSTGRES_PASSWORD=ваш_безопасный_пароль

# Telegram
TELEGRAM_BOT_TOKEN=ваш_токен_бота
CONTENT_ADMIN_CHAT_ID=128247430
TELEGRAM_CHANNEL_ID=-1001234567890
```

