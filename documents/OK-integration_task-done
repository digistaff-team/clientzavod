## 📦 Реализация сервисов

### 1. `services/okAuth.service.js`

```javascript
const crypto = require('crypto');
const axios = require('axios');

class OKAuthService {
  constructor() {
    this.appId = process.env.OK_APP_ID;
    this.publicKey = process.env.OK_PUBLIC_KEY;
    this.secretKey = process.env.OK_SECRET_KEY;
    this.accessToken = process.env.OK_ACCESS_TOKEN;
    this.sessionSecret = process.env.OK_SESSION_SECRET;
    this.groupId = process.env.OK_GROUP_ID;
  }

  // Подпись запроса по спецификации ОК API
  signRequest(params) {
    const sortedParams = Object.keys(params)
      .sort()
      .map(key => `${key}=${params[key]}`)
      .join('');
    
    const sig = crypto
      .createHash('md5')
      .update(sortedParams + this.sessionSecret)
      .digest('hex')
      .toLowerCase();
    
    return sig;
  }

  // Проверка валидности токена
  async validateToken() {
    try {
      const response = await axios.post('https://api.ok.ru/fb.do', {
        method: 'users.getCurrentUser',
        app_id: this.appId,
        access_token: this.accessToken,
        sig: this.signRequest({
          method: 'users.getCurrentUser',
          app_id: this.appId,
          access_token: this.accessToken
        })
      });
      return { valid: true, user: response.data };
    } catch (error) {
      return { valid: false, error: error.message };
    }
  }

  // Обновление токена (если есть refresh_token)
  async refreshToken() {
    // Реализация по документации ОК API
  }
}

module.exports = new OKAuthService();
```

### 2. `services/okContent.service.js`

```javascript
const aiRouterService = require('./ai_router_service');
const okAuth = require('./okAuth');

const OK_RULES = {
  textMin: 400,
  textMax: 600,
  textHardMax: 700,
  emojiMax: 3,
  hashtagMin: 2,
  hashtagMax: 4
};

class OKContentService {
  async generateText(topic, tov, dna) {
    const prompt = `
      ${process.env.OK_SYSTEM_PROMPT}
      
      Тема поста: ${topic}
      TOV: ${tov}
      ДНК бренда: ${dna}
    `;

    const result = await aiRouterService.call(prompt);
    
    // Валидация длины
    if (result.length > OK_RULES.textHardMax) {
      throw new Error(`Текст превышает лимит ОК: ${result.length} > ${OK_RULES.textHardMax}`);
    }

    return result;
  }

  async validateContent(text, imageUrl) {
    const errors = [];

    // Проверка длины текста
    if (text.length < OK_RULES.textMin) {
      errors.push(`Текст слишком короткий: ${text.length} < ${OK_RULES.textMin}`);
    }
    if (text.length > OK_RULES.textHardMax) {
      errors.push(`Текст слишком длинный: ${text.length} > ${OK_RULES.textHardMax}`);
    }

    // Проверка эмодзи
    const emojiCount = (text.match(/\p{Emoji}/gu) || []).length;
    if (emojiCount > OK_RULES.emojiMax) {
      errors.push(`Слишком много эмодзи: ${emojiCount} > ${OK_RULES.emojiMax}`);
    }

    // Проверка хештегов
    const hashtagCount = (text.match(/#\w+/g) || []).length;
    if (hashtagCount < OK_RULES.hashtagMin) {
      errors.push(`Слишком мало хештегов: ${hashtagCount} < ${OK_RULES.hashtagMin}`);
    }
    if (hashtagCount > OK_RULES.hashtagMax) {
      errors.push(`Слишком много хештегов: ${hashtagCount} > ${OK_RULES.hashtagMax}`);
    }

    // Проверка изображения
    if (!imageUrl) {
      errors.push('Отсутствует изображение');
    }

    return {
      valid: errors.length === 0,
      errors,
      metrics: {
        textLength: text.length,
        emojiCount,
        hashtagCount
      }
    };
  }
}

module.exports = new OKContentService();
```

### 3. `services/okPublisher.service.js`

```javascript
const axios = require('axios');
const FormData = require('form-data');
const okAuth = require('./okAuth');
const postgres = require('./postgres.service');

class OKPublisherService {
  // Шаг 1: Получить URL для загрузки фото
  async getUploadUrl(groupId) {
    const params = {
      method: 'photosV2.getUploadUrl',
      gid: groupId,
      app_id: okAuth.appId,
      access_token: okAuth.accessToken
    };
    params.sig = okAuth.signRequest(params);

    const response = await axios.post('https://api.ok.ru/fb.do', params);
    return response.data.upload_url;
  }

  // Шаг 2: Загрузить изображение
  async uploadImage(uploadUrl, imageData, fileName) {
    const form = new FormData();
    form.append('file', imageData, {
      filename: fileName,
      contentType: 'image/png'
    });

    const response = await axios.post(uploadUrl, form, {
      headers: form.getHeaders()
    });

    return response.data;
  }

  // Шаг 3: Опубликовать пост
  async publishPost(groupId, text, photoId) {
    const params = {
      method: 'media.post',
      gid: groupId,
      type: 'PHOTO',
      text: text,
      photos: JSON.stringify([{ id: photoId }]),
      app_id: okAuth.appId,
      access_token: okAuth.accessToken
    };
    params.sig = okAuth.signRequest(params);

    const response = await axios.post('https://api.ok.ru/fb.do', params);
    return response.data;
  }

  // Полный цикл публикации
  async publish(userId, topic, text, imageData) {
    const logId = await this.createLog(userId, topic, text, 'pending');

    try {
      // Валидация токена
      const tokenValid = await okAuth.validateToken();
      if (!tokenValid.valid) {
        throw new Error('Невалидный токен ОК API');
      }

      // Загрузка изображения
      const uploadUrl = await this.getUploadUrl(okAuth.groupId);
      const uploadResult = await this.uploadImage(uploadUrl, imageData, 'post.png');
      
      // Публикация поста
      const publishResult = await this.publishPost(
        okAuth.groupId,
        text,
        uploadResult.photo_id
      );

      // Обновление лога
      await this.updateLog(logId, {
        status: 'published',
        ok_post_id: publishResult.post_id,
        published_at: new Date()
      });

      // Обновление content_posts
      await postgres.query(`
        UPDATE content_posts 
        SET ok_published = TRUE, 
            ok_post_id = $1, 
            ok_publish_date = NOW()
        WHERE user_id = $2 AND topic = $3
      `, [publishResult.post_id, userId, topic]);

      return {
        success: true,
        postId: publishResult.post_id,
        logId
      };
    } catch (error) {
      await this.updateLog(logId, {
        status: 'error',
        error_message: error.message
      });

      throw error;
    }
  }

  async createLog(userId, topic, text, status) {
    const result = await postgres.query(`
      INSERT INTO ok_publish_logs (user_id, topic, text, text_length, status)
      VALUES ($1, $2, $3, $4, $5)
      RETURNING id
    `, [userId, topic, text, text.length, status]);
    
    return result.rows[0].id;
  }

  async updateLog(logId, data) {
    const fields = Object.keys(data).map((key, idx) => `${key} = $${idx + 2}`).join(', ');
    const values = Object.values(data);

    await postgres.query(`
      UPDATE ok_publish_logs 
      SET ${fields}
      WHERE id = $1
    `, [logId, ...values]);
  }
}

module.exports = new OKPublisherService();
```

