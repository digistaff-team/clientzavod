    🔄 Поток работы

    1. Перед вызовом ИИ

     1 // Проверяем, хватает ли токенов
     2 const estimatedTokens = TokenBilling.estimateTokens(messages, model);
     3 const canAfford = await TokenBilling.canAfford(chatId, estimatedTokens + 1000);
     4 
     5 if (!canAfford) {
     6     // Блокируем вызов, просим пополнить баланс
     7     await bot.sendMessage(chatId, '⛔ Токены закончились. Пополните: /pay');
     8     return;
     9 }

    2. После успешного вызова ИИ

      1 // Списываем токены по факту
      2 const usage = response.usage; // { prompt_tokens: 124, completion_tokens: 856 }
      3 const totalSpent = await TokenBilling.spendTokens(
      4     chatId,
      5     usage.prompt_tokens,
      6     usage.completion_tokens,
      7     model,
      8     'agent_loop: default mode'
      9 );
     10 
     11 // Запись в БД:
     12 // UPDATE users SET balance_tokens = balance_tokens - 1127 WHERE telegram_id = 
        $1
     13 // INSERT INTO token_transactions (...) VALUES (...)

    3. Ежемесячный сброс (1-го числа)

     1 // Автоматически восстанавливает баланс до планового
     2 UPDATE users 
     3 SET balance_tokens = monthly_included_tokens,
     4     next_reset_date = CURRENT_DATE + INTERVAL '1 month'
     5 WHERE next_reset_date <= CURRENT_DATE
     6   AND monthly_included_tokens > 0

