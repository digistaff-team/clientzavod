ALTER TABLE content_channels ADD COLUMN IF NOT EXISTS vk_upload_method VARCHAR(20) DEFAULT 'wall';
ALTER TABLE content_channels ADD COLUMN IF NOT EXISTS vk_publish_location VARCHAR(20) DEFAULT 'group';
ALTER TABLE content_channels ADD COLUMN IF NOT EXISTS vk_signed BOOLEAN DEFAULT true;
ALTER TABLE content_channels ADD COLUMN IF NOT EXISTS vk_primary_attachments_mode VARCHAR(20) DEFAULT 'carousel';

-- Таблица премодерации
CREATE TABLE IF NOT EXISTS vk_moderation_queue (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    job_id UUID NOT NULL,
    moderator_chat_id BIGINT NOT NULL,
    draft_text TEXT,
    draft_image_url TEXT,
    draft_video_url TEXT,
    vk_params JSONB,
    status VARCHAR(20) DEFAULT 'pending' CHECK (status IN ('pending', 'approved', 'rejected', 'published')),
    moderator_comment TEXT,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    reviewed_at TIMESTAMPTZ,
    published_at TIMESTAMPTZ,
    FOREIGN KEY (job_id) REFERENCES content_jobs(id) ON DELETE CASCADE
);

-- Индексы для ускорения выборки
CREATE INDEX idx_vk_moderation_status ON vk_moderation_queue(status, created_at);
CREATE INDEX idx_vk_moderation_moderator ON vk_moderation_queue(moderator_chat_id, status);
```

