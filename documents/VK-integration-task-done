## 🤖 3. Telegram-бот: команды премодерации

### Регистрация хендлеров в `manage/telegram/runner.js`

```javascript
// Команды для модератора
bot.onText(/\/vk_pending$/, async (msg) => {
  // Показать список ожидающих премодерации задач
});

bot.onText(/\/vk_review (\S+)/, async (msg, match) => {
  // Показать черновик для ревью: текст + превью медиа + параметры публикации
  // Кнопки: [✅ Одобрить] [❌ Отклонить] [✏️ Редактировать]
});

// Callback queries для кнопок
bot.on('callback_query', async (query) => {
  const [action, taskId] = query.data.split(':');
  
  if (action === 'vk_approve') {
    await moderationService.processModerationDecision({
      taskId, decision: 'approved', comment: null
    });
    await bot.answerCallbackQuery(query.id, { text: '✅ Опубликовано в VK' });
  }
  
  if (action === 'vk_reject') {
    // Запрос комментария от модератора
    // Обновление статуса на 'rejected'
  }
});
```

